PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/reclaim.sqlite
# Sandbox only. Create an app at developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional first-time merchant bootstrap; otherwise setup generates a random password.
MERCHANT_EMAIL=merchant@reclaim.local
MERCHANT_PASSWORD=
# Set true only behind HTTPS. Match APP_URL to the external origin.
SECURE_COOKIES=false
